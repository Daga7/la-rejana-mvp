# =============================================================================
# La Rejana Callejera · variables de entorno
# Copia este archivo a `.env` en la raíz del repo (lo lee Next.js en desarrollo: web y "API" son
# el mismo proceso, bajo apps/web; packages/server solo aporta el código, sin servidor aparte).
# En Vercel se definen en el panel del proyecto: lista exacta en el README (Desplegar).
# Nunca subas el `.env` real al repositorio.
# =============================================================================

# --- General -----------------------------------------------------------------
NODE_ENV=development
# Nivel de logs: fatal | error | warn | info | debug
LOG_LEVEL=info

# --- Base de datos (Supabase Postgres) ----------------------------------------
# PostgreSQL. En producción, la URI del «Session pooler» de Supabase (puerto 5432, usuario postgres.<ref>).
DATABASE_URL=postgres://rejana:rejana_local_solo_dev@127.0.0.1:5433/rejana
# Base de datos para `pnpm test` (se borra y recrea en cada corrida de pruebas).
DATABASE_URL_TEST=postgres://rejana:rejana_local_solo_dev@127.0.0.1:5433/rejana_test
# true con Supabase (TLS). Los parámetros sslmode de la URL se ignoran: manda esta variable.
DATABASE_SSL=false
# Opcional: certificado raíz del proveedor (PEM; sirve con \n en una sola línea) para verificar el servidor.
# Sin él la conexión se cifra sin verificar. Supabase: Database Settings → SSL Configuration → Download certificate.
DATABASE_SSL_CA=
# Conexiones máximas (10 por defecto). Con Supabase gratis (pool de 15) usa 5.
# DATABASE_POOL_MAX=10

# --- Tiempo real (Supabase Realtime) ------------------------------------------
# Mismo proyecto de Supabase que la base de datos. Project Settings → Data API → URL / service_role key.
# Sin esto, la web sigue funcionando pero sin tiempo real (sondeo con SWR).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (enlaces en correos, redirecciones de OAuth, verificación de Origin/CSRF).
WEB_ORIGIN=http://localhost:3000
# Orígenes extra permitidos (vistas previas de Vercel), separados por coma (opcional).
CORS_ORIGINS=

# Secretos (mínimo 32 caracteres aleatorios cada uno). Genera con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-1
# Pimienta (HMAC) para códigos de verificación y tokens de un solo uso.
TOKENS_PEPPER=cambia-esto-por-un-secreto-largo-y-aleatorio-2

# Cookies `Secure` + prefijo __Host- (obligatorio en producción con HTTPS).
COOKIE_SECURE=false
# Inicios de sesión por minuto e IP (en producción siempre 10). Súbelo solo en local para las pruebas e2e: LIMITE_INGRESOS_POR_MINUTO=60
# LIMITE_INGRESOS_POR_MINUTO=10
# Consulta Have I Been Pwned (k-anonimato) para rechazar contraseñas filtradas.
HIBP_HABILITADO=true
# Solo desarrollo/demos: aceptar pedidos aunque la sede esté cerrada (en producción: false).
PERMITIR_PEDIDOS_FUERA_DE_HORARIO=false

# --- Arranque sin consola ------------------------------------------------------
# Carga los datos de prueba al arrancar SOLO si la base está vacía (sin sedes ni usuarios).
# Con NODE_ENV=production exige también SEED_PERMITIR_PRODUCCION=true (crean usuarios con contraseña conocida).
SEED_AL_INICIAR=false
SEED_PERMITIR_PRODUCCION=false
# Si no hay ningún administrador activo, se envía a este correo una invitación de un solo uso (vence en 2 h).
ADMIN_INICIAL_CORREO=

# --- Correo -------------------------------------------------------------------
# consola = imprime en logs | smtp = cualquier SMTP (Mailpit en local) | resend = API de Resend
EMAIL_PROVEEDOR=smtp
EMAIL_REMITENTE="La Rejana Callejera <no-responder@larejana.co>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USUARIO=
SMTP_CLAVE=
RESEND_API_KEY=

# --- Inicio de sesión con Google / Apple -----------------------------------------
# En desarrollo, OAUTH_MOCK=true muestra un selector falso para probar el flujo sin credenciales.
OAUTH_MOCK=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: Services ID, Team ID, Key ID y la llave privada .p8 (con \n escapados).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Notificaciones push (Web Push / VAPID) ---------------------------------------
# Genera un par con: pnpm --filter @rejana/server exec web-push generate-vapid-keys
# Sin llaves, las notificaciones se imprimen en consola.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@larejana.co

# --- Mapas y rutas ----------------------------------------------------------------
# haversine = sin proveedor (distancia en línea recta × factor vial) | osrm | google
MAPAS_PROVEEDOR=haversine
OSRM_URL=https://router.project-osrm.org
GOOGLE_MAPS_API_KEY=
# Velocidad promedio de una moto en Bogotá para estimar tiempos (km/h).
VELOCIDAD_PROMEDIO_KMH=22
# Buscador de direcciones: nominatim | google | ninguno
GEOCODER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Asistente de WhatsApp ---------------------------------------------------------
# consola = guarda los PDF en packages/server/tmp/whatsapp | meta = WhatsApp Business Cloud API
WHATSAPP_PROVEEDOR=consola
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0

# Intérprete de solicitudes: reglas (sin IA, palabras clave) | anthropic | gemini
IA_PROVEEDOR=reglas
ANTHROPIC_API_KEY=
# Modelo por defecto: claude-opus-5-5. Para bajar costos puede usarse claude-haiku-5-5 (decisión del negocio).
ANTHROPIC_MODEL=claude-opus-5-5
# Gemini (gratis con límites): crea la llave en aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Transcripción de notas de voz: mock | openai (cualquier API compatible con /audio/transcriptions)
STT_PROVEEDOR=mock
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODELO=gpt-4o-mini-transcribe

# --- Web (apps/web) -------------------------------------------------------------
# Teselas del mapa (OpenStreetMap por defecto; en producción usa un proveedor con llave).
MAPA_TESELAS_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAPA_ATRIBUCION="© OpenStreetMap"
