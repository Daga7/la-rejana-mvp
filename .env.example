# =============================================================================
# La Rejana Callejera · variables de entorno
# Copia este archivo a `.env` en la raíz del repo (lo leen la API y la web en desarrollo).
# En Railway/Vercel define las mismas variables en el panel de cada servicio.
# Nunca subas el `.env` real al repositorio.
# =============================================================================

# --- General -----------------------------------------------------------------
NODE_ENV=development
# Nivel de logs de la API: fatal | error | warn | info | debug
LOG_LEVEL=info

# --- API (apps/api) -----------------------------------------------------------
PORT=4000
HOST=0.0.0.0
# PostgreSQL. En Railway usa la variable DATABASE_URL del plugin de Postgres.
DATABASE_URL=postgres://rejana:rejana_local_solo_dev@127.0.0.1:5433/rejana
# Base de datos para `pnpm test` (se borra y recrea en cada corrida de pruebas).
DATABASE_URL_TEST=postgres://rejana:rejana_local_solo_dev@127.0.0.1:5433/rejana_test
# true si el proveedor exige TLS (Railway por red pública). En la red privada de Railway: false.
DATABASE_SSL=false

# URL pública del frontend (CORS, enlaces en correos, redirecciones de OAuth).
WEB_ORIGIN=http://localhost:3000
# URL pública de la API (webhooks de WhatsApp, WebSocket).
API_PUBLIC_URL=http://localhost:4000
# Orígenes extra permitidos por CORS, separados por coma (opcional).
CORS_ORIGINS=

# Secretos (mínimo 32 caracteres aleatorios cada uno). Genera con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-1
# Pimienta (HMAC) para códigos de verificación y tokens de un solo uso.
TOKENS_PEPPER=cambia-esto-por-un-secreto-largo-y-aleatorio-2
# Secreto compartido entre el proxy de la web y la API (permite confiar en la IP real del cliente).
PROXY_SHARED_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-3

# Cookies `Secure` + prefijo __Host- (obligatorio en producción con HTTPS).
COOKIE_SECURE=false
# Saltos de proxy de la plataforma delante de la API (Railway = 1). 0 en local.
TRUST_PROXY_HOPS=0
# Consulta Have I Been Pwned (k-anonimato) para rechazar contraseñas filtradas.
HIBP_HABILITADO=true
# Solo desarrollo/demos: aceptar pedidos aunque la sede esté cerrada (en producción: false).
PERMITIR_PEDIDOS_FUERA_DE_HORARIO=false

# --- Correo -------------------------------------------------------------------
# consola = imprime en logs | smtp = cualquier SMTP (Mailpit en local) | resend = API de Resend
EMAIL_PROVEEDOR=smtp
EMAIL_REMITENTE="La Rejana Callejera <no-responder@larejana.co>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USUARIO=
SMTP_CLAVE=
RESEND_API_KEY=

# --- Inicio de sesión con Google / Apple -----------------------------------------
# En desarrollo, OAUTH_MOCK=true muestra un selector falso para probar el flujo sin credenciales.
OAUTH_MOCK=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: Services ID, Team ID, Key ID y la llave privada .p8 (con \n escapados).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Notificaciones push (Web Push / VAPID) ---------------------------------------
# Genera un par con: pnpm --filter @rejana/api exec web-push generate-vapid-keys
# Sin llaves, las notificaciones se imprimen en consola.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@larejana.co

# --- Mapas y rutas ----------------------------------------------------------------
# haversine = sin proveedor (distancia en línea recta × factor vial) | osrm | google
MAPAS_PROVEEDOR=haversine
OSRM_URL=https://router.project-osrm.org
GOOGLE_MAPS_API_KEY=
# Velocidad promedio de una moto en Bogotá para estimar tiempos (km/h).
VELOCIDAD_PROMEDIO_KMH=22
# Buscador de direcciones: nominatim | google | ninguno
GEOCODER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Asistente de WhatsApp ---------------------------------------------------------
# consola = guarda los PDF en apps/api/tmp/whatsapp | meta = WhatsApp Business Cloud API
WHATSAPP_PROVEEDOR=consola
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0

# Intérprete de solicitudes: reglas (sin IA, palabras clave) | anthropic
IA_PROVEEDOR=reglas
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Transcripción de notas de voz: mock | openai (cualquier API compatible con /audio/transcriptions)
STT_PROVEEDOR=mock
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODELO=gpt-4o-mini-transcribe

# --- Web (apps/web) -------------------------------------------------------------
# A dónde reenvía el proxy /api/* de Next.js (red privada si ambos están en Railway).
API_INTERNAL_URL=http://localhost:4000
# La web también usa API_PUBLIC_URL (arriba) para el WebSocket y la CSP. Se leen en tiempo de
# ejecución: la misma imagen sirve para cualquier entorno.
# Teselas del mapa (OpenStreetMap por defecto; en producción usa un proveedor con llave).
MAPA_TESELAS_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAPA_ATRIBUCION="© OpenStreetMap"
