{
  "name": "@rejana/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PWA de La Rejana Callejera (Next.js App Router).",
  "scripts": {
    "dev": "node scripts/next-con-env.mjs dev --port 3000",
    "build": "node scripts/next-con-env.mjs build",
    "start": "node scripts/next-con-env.mjs start --port ${PORT:-3000}",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "lint": "eslint",
    "test": "vitest run --dir src --passWithNoTests",
    "iconos": "node scripts/generar-iconos.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@rejana/shared": "workspace:*",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.67.0",
    "motion": "^14.9.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "^5.0.0",
    "swr": "^2.5.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16",
    "@rejana/server": "workspace:*",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@next/env": "16.4.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4.3.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
