{
  "name": "rejanamvp",
  "private": true,
  "type": "module",
  "description": "MVP PWA de La Rejana Callejera: domicilios, cocina, caja, domiciliario y administración.",
  "scripts": {
    "dev": "pnpm --filter @rejana/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:up": "docker compose up -d db mailpit",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @rejana/server db:generate",
    "db:migrate": "pnpm --filter @rejana/server db:migrate",
    "db:seed": "pnpm --filter @rejana/server db:seed",
    "db:reset": "pnpm --filter @rejana/server db:reset"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.5.1"
}
