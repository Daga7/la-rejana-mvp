{
  "name": "@rejana/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend de La Rejana Callejera (casos de uso, dominio y adaptadores). Se sirve desde los route handlers de Next.js.",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/adapters/db/migrar.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/adapters/db/sembrar-cli.ts",
    "db:reset": "tsx --env-file-if-exists=../../.env src/adapters/db/reset.ts",
    "admin:crear": "tsx --env-file-if-exists=../../.env src/adapters/db/crear-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@google/genai": "^2.32.0",
    "@rejana/shared": "workspace:*",
    "@supabase/supabase-js": "^2.58.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.15.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  }
}
